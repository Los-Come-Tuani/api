DEBUG="True"
DEPLOY="False"
SKIP_SEEDERS="False"

DATABASE_URL="postgresql://kplanapi:kplanapi@127.0.0.1:5432/kplanapi"
REDIS_URL="redis://127.0.0.1:6379"

JWT_SECRET_KEY="SECRET!!!"
SECRET_KEY="SECRET!!!"

REDIS_SECRET_KEY="kplanapi"

# Llaves Fernet con las que se cifra el secreto del 2FA (TOTP) en la base, separadas por
# comas y la más nueva primero. Vacía = se deriva de SECRET_KEY, solo válido en
# desarrollo; con DEPLOY=True es obligatoria. Genere una con `just fernet-key`.
# Rotar: anteponga una llave nueva, corra `rotatetotpkeys` y retire la vieja.
TOTP_ENCRYPTION_KEYS=""

# Listas separadas por comas. Vacías = valores de desarrollo: localhost, el portal
# (http://localhost:5173) y 10.0.2.2, que es como el emulador de Android llega al
# `localhost` de esta máquina. En producción se definen en las variables del servicio
# (Railway), nunca en el repositorio; los orígenes deben ser https y sin "/" final.
# Usa `localhost` (no 127.0.0.1) en el portal y en el API: mezclarlos vuelve
# cross-site a las cookies de sesión.
ALLOWED_HOSTS=""
CORS_ALLOWED_ORIGINS=""
CSRF_TRUSTED_ORIGINS=""

# Inicio de sesión con Google: Client ID de tipo "Web" (público, sin secretos), separados
# por comas. Vacío = Google deshabilitado. Guía: docs/google.md
GOOGLE_OAUTH_CLIENT_IDS=""

# Para probar con un teléfono físico por USB: `adb reverse tcp:8080 tcp:8080`.
# Por Wi-Fi: GRANIAN_HOST="0.0.0.0", agrega la IP de la LAN a ALLOWED_HOSTS y
# abre el puerto en el firewall (solo en redes de confianza).
GRANIAN_HOST="127.0.0.1"
GRANIAN_INTERFACE="asginl"
GRANIAN_LOG_ACCESS_ENABLED="1"
GRANIAN_PORT="8080"
GRANIAN_RELOAD_PATHS="src"
GRANIAN_WORKERS="1"
GRANIAN_WORKING_DIR="src"
GRANIAN_WS="0"

# El superusuario entra por correo, como todas las cuentas.
DJANGO_SUPERUSER_EMAIL="admin@example.com"
DJANGO_SUPERUSER_PASSWORD="Superuser-Data-2026"

# Correo saliente (códigos de verificación y recuperación de contraseña). Vacío,
# en desarrollo los correos salen por la consola del API; con DEPLOY=True se
# descartan para que ningún código quede escrito en los logs. En producción
# define estas variables en el servicio, nunca aquí.
DEFAULT_FROM_EMAIL="K'Plan <no-reply@localhost>"
EMAIL_HOST=""
EMAIL_HOST_PASSWORD=""
EMAIL_HOST_USER=""
EMAIL_PORT="587"
EMAIL_USE_TLS="True"

# Solo para un API de pruebas sin correo (develop-api): cualquier código de seis dígitos
# sirve para crear una cuenta. La recuperación de contraseña y las invitaciones siguen
# pidiendo el código real. Con EMAIL_HOST no tiene efecto. Nunca en producción.
VERIFICATION_ACCEPT_ANY_SIGNUP_CODE="False"

# Almacenamiento de archivos (documentos legales y fotos de las solicitudes): un bucket
# compatible con S3, por ejemplo Cloudflare R2. El cliente sube directo con una URL
# firmada. Vacío, subir archivos responde 503. Son secretos: en producción se definen en
# las variables del servicio, nunca aquí. Guía: docs/archivos.md
STORAGE_ACCESS_KEY_ID=""
STORAGE_BUCKET=""
STORAGE_ENDPOINT_URL=""
STORAGE_REGION="auto"
STORAGE_SECRET_ACCESS_KEY=""

# Avisos al teléfono con Firebase Cloud Messaging: el id del proyecto y el JSON de la
# cuenta de servicio en una sola línea. Vacíos, los avisos quedan solo en la bandeja de la
# app. La cuenta de servicio es un secreto: en producción va en las variables del
# servicio, nunca aquí. Guía: docs/avisos.md
FCM_PROJECT_ID=""
FCM_SERVICE_ACCOUNT=""

# Cobro de las reservas. Con la pasarela "manual" el turista ve estas instrucciones y el
# equipo confirma el pago a mano. Guía: docs/finanzas.md
PAYMENT_GATEWAY="manual"
PAYMENT_INSTRUCTIONS="El equipo de K'Plan te escribirá para confirmar el pago de tu reserva."
